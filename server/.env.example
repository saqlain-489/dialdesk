# Copy to server/.env and fill in. Every value here is a placeholder.

PORT=4001
# Twilio signs webhooks against this exact origin: no trailing slash.
PUBLIC_URL=http://localhost:4001
MONGO_URI=mongodb://127.0.0.1:27017/dialdesk
NODE_ENV=development

# openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-string
# openssl rand -base64 32 (encrypts each workspace's Twilio secrets; the server refuses to start without it)
ORG_SECRETS_KEY=replace-with-32-random-bytes-base64

# Access-token lifetime in seconds. Twilio keys live encrypted in the database, not here:
# load them with `npm run org -- set-twilio <workspace> --from-file <file>`.
TWILIO_TOKEN_TTL=600
# Workspace slug that owns the bare /api/twilio/voice paths (single-tenant setups). Empty refuses them.
LEGACY_WEBHOOK_ORG=

# Calling hours, enforced by the voice webhook in the leads' time zone.
CALL_TZ=America/New_York
CALL_WINDOW_START=9
CALL_WINDOW_END=17
CALL_WINDOW_DAYS=1,2,3,4,5

RETRY_GAP_DAYS=3
MAX_ATTEMPTS=5
RECYCLE_REST_DAYS=60

# Two-letter state codes whose leads may be recorded for a transcript. Empty records nobody.
# Check the recording-consent law for every state you list.
TRANSCRIBE_ENABLED=true
TRANSCRIBE_STATES=
TRANSCRIBE_MODEL=Xenova/whisper-base.en

# Shared with the receptionist worker (receptionist/.dev.vars). Empty disables inbound ingest.
INBOUND_SHARED_SECRET=replace-with-a-long-random-string
RECEPTIONIST_URL=https://dialdesk-receptionist.example.workers.dev

# Optional, for `npm run sync:dnc`: a database whose `leads` collection flags opt-outs.
SOURCE_MONGO_URI=mongodb://127.0.0.1:27017/leads
